{
  "name": "agent-forge",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:contract && npm run test:bash",
    "test:unit": "node --test tests/*.test.ts",
    "test:contract": "node --test tests/contract/*.test.ts",
    "test:bash": "for t in tests/test-*.sh; do bash \"$t\" || exit 1; done",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:ansible": "ansible-playbook -i ansible/tests/unit-inventory.yml ansible/tests/unit.yml",
    "check": "tsc --noEmit",
    "hooks:install": "bash .githooks/install.sh",
    "secrets:triage": "bash .github/scripts/triage-secrets.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^24.0.0"
  }
}
